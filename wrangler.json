{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "asean",
	"main": "./workers/app.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare"
	},
	"d1_databases": [
		{
			"binding": "AUTH_DB",
			"database_name": "to-trust",
			"database_id": "6f7f17e5-74a6-46a1-a424-a1e5b0cb7284"
		}
	],
	"kv_namespaces": [
		{
			"binding": "AUTH_KV",
			"id": "6ffcc61aed814e32b80e29c6fa5b44ee"
		}
	]
}
