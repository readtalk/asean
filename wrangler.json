{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "asean",
	"main": "./workers/app.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"VALUE_FROM_CLOUDFLARE": "Cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DATA_DB",
			"database_name": "SERVER_D1",
			"database_id": "9c6d47de-7136-494a-96aa-3e16648a4880"
		}
	],
	"kv_namespaces": [
		{
			"binding": "DATA_KV",
			"id": "54f89be27a414fabaf381a919403582e"
		}
	]
}
